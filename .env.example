# ---------------------------------------------------------------------------
# REQUIRED
# ---------------------------------------------------------------------------

# Password for the web UI. Use a long, random value.
APP_PASSWORD=change-me-please-use-something-long

# ...or supply a pre-computed argon2 hash instead of a plaintext password:
# APP_PASSWORD_HASH=

# Secret used to sign session cookies. Generate with: openssl rand -hex 32
# If unset, an ephemeral key is used and every restart logs users out.
SECRET_KEY=

# ---------------------------------------------------------------------------
# OLLAMA TARGETS
# ---------------------------------------------------------------------------

# JSON list of selectable Ollama instances. There's no bundled Ollama
# container - point this at one you already run, e.g. a native install on
# the Docker host (host.docker.internal resolves to it on Docker
# Desktop/Windows/Mac) or a remote instance.
OLLAMA_INSTANCES=[{"name":"local","url":"http://host.docker.internal:11434"}]

# Fallback single instance (used only when OLLAMA_INSTANCES is empty):
# OLLAMA_URL=http://host.docker.internal:11434

# ---------------------------------------------------------------------------
# SECURITY / BEHAVIOUR
# ---------------------------------------------------------------------------

# Serve session cookies only over HTTPS. Set to false for local http testing.
COOKIE_SECURE=true

# Trust X-Forwarded-For (only enable when behind a trusted reverse proxy).
# When enabling this, also set FORWARDED_ALLOW_IPS to the proxy's IP so
# uvicorn itself only accepts forwarded headers from that host. Never use "*"
# for FORWARDED_ALLOW_IPS - it lets any client spoof their IP and defeat the
# per-IP login lockout.
TRUST_PROXY=false
# FORWARDED_ALLOW_IPS=127.0.0.1

# Allow download URLs that resolve to private/loopback/link-local addresses.
# Keep false unless you really need it (SSRF protection).
ALLOW_PRIVATE_DOWNLOAD_URLS=false

MAX_GGUF_SIZE_GB=100
DELETE_GGUF_ON_FAILURE=true
SESSION_MAX_AGE_HOURS=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Optional Hugging Face token (sent only to huggingface.co / hf.co hosts, and
# to the optional converter service for gated/private repos).
# HF_TOKEN=

# Max size of a Hugging Face repo the optional "Convert from HF" page will
# download (only *.safetensors + config/tokenizer files are counted).
MAX_HF_REPO_SIZE_GB=80

# Host port the web UI is published on (docker compose).
WEB_PORT=8080
